@model ControleFinanceiro.Models.CartaoCredito
@using System.Globalization

@{
    ViewData["Title"] = "Excluir Cartão de Crédito";
    var culturaBr = new CultureInfo("pt-BR");
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card-custom p-4 border-danger">
            <h4 class="fw-bold text-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirmar Exclusão
            </h4>

            <p>Você tem certeza que deseja excluir o cartão <strong>@Model.Nome</strong>?</p>

            <div class="bg-light p-3 rounded-3 mb-4 border">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted fs-7">Limite Total:</span>
                    <strong class="fs-6">@Model.LimiteTotal.ToString("C", culturaBr)</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted fs-7">Dia de Fechamento / Vencimento:</span>
                    <span>Dia @Model.DiaFechamento / Dia @Model.DiaVencimento</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted fs-7">Programa de Pontos:</span>
                    <span>@(Model.AcumulaPontos ? Model.NomeProgramaPontos : "Não acumula")</span>
                </div>
            </div>

            @if (Model.Transacoes.Any())
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Atenção: Este cartão possui <strong>@Model.Transacoes.Count transação(ões)</strong> vinculadas. Você não poderá excluí-lo até remover essas transações.
                </div>
            }

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">Cancelar</a>
                    <button type="submit" class="btn btn-danger rounded-3" disabled="@(Model.Transacoes.Any())">Excluir Definitivamente</button>
                </div>
            </form>
        </div>
    </div>
</div>
