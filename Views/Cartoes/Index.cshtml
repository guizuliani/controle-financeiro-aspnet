@model IEnumerable<ControleFinanceiro.Models.ViewModels.CartaoResumoItem>
@using System.Globalization

@{
    ViewData["Title"] = "Cartões de Crédito";
    var culturaBr = new CultureInfo("pt-BR");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-credit-card-2-front text-primary"></i> Meus Cartões de Crédito</h2>
        <p class="text-muted mb-0">Gerencie seus limites, datas de fechamento e regras de pontuação.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-custom-primary d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle-fill"></i> Novo Cartão
        </a>
    </div>
</div>

<div class="row g-4">
    @if (Model.Any())
    {
        @foreach (var cartao in Model)
        {
            <div class="col-lg-6 col-xl-4">
                <div class="card-custom h-100 p-0 overflow-hidden d-flex flex-column">
                    <!-- Topo estilizado do Cartão Físico -->
                    <div class="p-4 text-white" style="background: linear-gradient(135deg, @cartao.CorHex 0%, #0f172a 100%);">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <i class="bi bi-sim fs-3 text-warning"></i>
                                <span class="badge bg-white text-dark ms-2 fw-semibold">@cartao.NomeProgramaPontos</span>
                            </div>
                            <i class="bi bi-credit-card-fill fs-2 opacity-75"></i>
                        </div>
                        <h5 class="fw-bold mb-1 text-truncate" title="@cartao.Nome">@cartao.Nome</h5>
                        <div class="d-flex justify-content-between mt-3 text-white-50 fs-7">
                            <div>
                                <small class="d-block">Fechamento</small>
                                <strong class="text-white">Dia @cartao.DiaFechamento</strong>
                            </div>
                            <div>
                                <small class="d-block">Vencimento</small>
                                <strong class="text-white">Dia @cartao.DiaVencimento</strong>
                            </div>
                            <div class="text-end">
                                <small class="d-block">Fatura Atual</small>
                                <strong class="text-white">@cartao.FaturaMesAtual.ToString("C", culturaBr)</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Corpo com Limite e Ações -->
                    <div class="p-4 d-flex flex-column justify-content-between flex-grow-1">
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fs-7 text-muted fw-semibold">Uso do Limite:</span>
                                <span class="fs-7 fw-bold text-dark">@cartao.PercentualUso%</span>
                            </div>
                            <div class="progress rounded-pill" style="height: 10px;">
                                <div class="progress-bar @(cartao.PercentualUso > 80 ? "bg-danger" : (cartao.PercentualUso > 50 ? "bg-warning" : "bg-primary"))" 
                                     role="progressbar" 
                                     style="width: @cartao.PercentualUso%;" 
                                     aria-valuenow="@cartao.PercentualUso" 
                                     aria-valuemin="0" 
                                     aria-valuemax="100"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-2 fs-7 text-muted">
                                <span>Utilizado: <strong class="text-danger">@cartao.LimiteUtilizado.ToString("C", culturaBr)</strong></span>
                                <span>Disponível: <strong class="text-success">@cartao.LimiteDisponivel.ToString("C", culturaBr)</strong></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-top pt-3 gap-2">
                            <a asp-action="Fatura" asp-route-id="@cartao.Id" class="btn btn-sm btn-primary rounded-3 flex-grow-1">
                                <i class="bi bi-receipt"></i> Ver Fatura
                            </a>
                            <a asp-action="Edit" asp-route-id="@cartao.Id" class="btn btn-sm btn-outline-secondary rounded-3" title="Editar">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@cartao.Id" class="btn btn-sm btn-outline-danger rounded-3" title="Excluir">
                                <i class="bi bi-trash-fill"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card-custom p-5 text-center text-muted">
                <i class="bi bi-credit-card fs-1 mb-2"></i>
                <h5>Nenhum cartão cadastrado ainda.</h5>
                <p>Cadastre seus cartões de crédito para controlar faturas e pontuações de milhas.</p>
                <div>
                    <a asp-action="Create" class="btn btn-custom-primary">Cadastrar Primeiro Cartão</a>
                </div>
            </div>
        </div>
    }
</div>
