@model ControleFinanceiro.Models.Transacao
@using ControleFinanceiro.Models.Enums

@{
    ViewData["Title"] = "Editar Transação";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card-custom p-4">
            <h4 class="fw-bold mb-4">
                <i class="bi bi-pencil-square text-primary"></i> Editar Transação
            </h4>

            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Tipo" class="form-label fw-semibold"></label>
                        <select asp-for="Tipo" class="form-select rounded-3" asp-items="Html.GetEnumSelectList<TipoTransacao>()">
                        </select>
                        <span asp-validation-for="Tipo" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategoriaId" class="form-label fw-semibold">Categoria</label>
                        <select asp-for="CategoriaId" class="form-select rounded-3" asp-items="ViewBag.CategoriaId">
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label fw-semibold">Descrição</label>
                    <input asp-for="Descricao" class="form-control rounded-3" />
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Valor" class="form-label fw-semibold">Valor (R$)</label>
                        <input asp-for="Valor" type="number" step="0.01" class="form-control rounded-3" />
                        <span asp-validation-for="Valor" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Data" class="form-label fw-semibold">Data da Transação</label>
                        <input asp-for="Data" type="date" class="form-control rounded-3" />
                        <span asp-validation-for="Data" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Observacao" class="form-label fw-semibold">Observações</label>
                    <textarea asp-for="Observacao" class="form-control rounded-3" rows="3"></textarea>
                    <span asp-validation-for="Observacao" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">Cancelar</a>
                    <button type="submit" class="btn btn-primary rounded-3">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>
</div>
