@model ControleFinanceiro.Models.Transacao
@using ControleFinanceiro.Models.Enums

@{
    ViewData["Title"] = "Nova Transação";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card-custom p-4">
            <h4 class="fw-bold mb-4">
                <i class="bi bi-plus-circle-fill text-primary"></i> Cadastrar Nova Transação
            </h4>

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Tipo" class="form-label fw-semibold"></label>
                        <select asp-for="Tipo" class="form-select rounded-3" id="selectTipo" asp-items="Html.GetEnumSelectList<TipoTransacao>()">
                        </select>
                        <span asp-validation-for="Tipo" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FormaPagamento" class="form-label fw-semibold"></label>
                        <select asp-for="FormaPagamento" class="form-select rounded-3" id="selectFormaPagamento" asp-items="Html.GetEnumSelectList<FormaPagamento>()">
                        </select>
                        <span asp-validation-for="FormaPagamento" class="text-danger"></span>
                    </div>
                </div>

                <!-- Painel Condicional para Cartão de Crédito -->
                <div id="painelCartao" class="card p-3 rounded-3 mb-3 bg-light border" style="display: none;">
                    <h6 class="fw-bold text-primary mb-3"><i class="bi bi-credit-card-2-front"></i> Detalhes do Cartão & Parcelamento</h6>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="CartaoCreditoId" class="form-label fw-semibold">Selecione o Cartão</label>
                            <select asp-for="CartaoCreditoId" class="form-select rounded-3" asp-items="ViewBag.CartaoCreditoId">
                                <option value="">-- Escolha o Cartão --</option>
                            </select>
                            <span asp-validation-for="CartaoCreditoId" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="TotalParcelas" class="form-label fw-semibold">Nº de Parcelas</label>
                            <input asp-for="TotalParcelas" type="number" min="1" max="48" class="form-control rounded-3" value="1" />
                            <small class="text-muted">1x à vista ou até 48x.</small>
                            <span asp-validation-for="TotalParcelas" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label fw-semibold">Descrição</label>
                    <input asp-for="Descricao" class="form-control rounded-3" placeholder="Ex: Supermercado, Salário, Celular novo..." />
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Valor" class="form-label fw-semibold">Valor Total (R$)</label>
                        <input asp-for="Valor" type="number" step="0.01" class="form-control rounded-3" placeholder="0,00" />
                        <span asp-validation-for="Valor" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CategoriaId" class="form-label fw-semibold">Categoria</label>
                        <select asp-for="CategoriaId" class="form-select rounded-3" asp-items="ViewBag.CategoriaId">
                            <option value="">-- Selecione a Categoria --</option>
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Data" class="form-label fw-semibold">Data da Operação</label>
                        <input asp-for="Data" type="date" class="form-control rounded-3" />
                        <span asp-validation-for="Data" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Observacao" class="form-label fw-semibold">Observações (opcional)</label>
                    <textarea asp-for="Observacao" class="form-control rounded-3" rows="3" placeholder="Detalhes adicionais..."></textarea>
                    <span asp-validation-for="Observacao" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">Cancelar</a>
                    <button type="submit" class="btn btn-custom-primary">Salvar Transação</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const selectForma = document.getElementById('selectFormaPagamento');
        const selectTipo = document.getElementById('selectTipo');
        const painelCartao = document.getElementById('painelCartao');

        function atualizarPainel() {
            // FormaPagamento.CartaoCredito = 2
            if (selectForma.value === "2") {
                painelCartao.style.display = 'block';
                selectTipo.value = "2"; // Cartão é sempre Despesa
                selectTipo.disabled = true;
            } else {
                painelCartao.style.display = 'none';
                selectTipo.disabled = false;
            }
        }

        selectForma.addEventListener('change', atualizarPainel);
        atualizarPainel();
    </script>
}
