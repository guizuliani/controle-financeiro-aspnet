@model ControleFinanceiro.Models.ResgatePontos

@{
    ViewData["Title"] = "Registrar Resgate de Pontos";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card-custom p-4">
            <h4 class="fw-bold mb-4">
                <i class="bi bi-box-arrow-up-right text-warning"></i> Registrar Resgate / Transferência de Pontos
            </h4>

            <form asp-action="Resgatar">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CartaoCreditoId" class="form-label fw-semibold">Cartão / Programa de Origem</label>
                    <select asp-for="CartaoCreditoId" class="form-select rounded-3" asp-items="ViewBag.Cartoes">
                        <option value="">-- Selecione o Cartão --</option>
                    </select>
                    <span asp-validation-for="CartaoCreditoId" class="text-danger"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Pontos" class="form-label fw-semibold">Quantidade de Pontos</label>
                        <input asp-for="Pontos" type="number" step="1" class="form-control rounded-3" placeholder="Ex: 10000" />
                        <span asp-validation-for="Pontos" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Data" class="form-label fw-semibold">Data da Operação</label>
                        <input asp-for="Data" type="date" class="form-control rounded-3" />
                        <span asp-validation-for="Data" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Descricao" class="form-label fw-semibold">Descrição / Destino</label>
                    <input asp-for="Descricao" class="form-control rounded-3" placeholder="Ex: Transferência para Smiles (100% bônus), Resgate em Cashback..." />
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">Cancelar</a>
                    <button type="submit" class="btn btn-warning text-dark fw-bold rounded-3">Confirmar Resgate</button>
                </div>
            </form>
        </div>
    </div>
</div>
