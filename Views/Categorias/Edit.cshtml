@model ControleFinanceiro.Models.Categoria

@{
    ViewData["Title"] = "Editar Categoria";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card-custom p-4">
            <h4 class="fw-bold mb-4">
                <i class="bi bi-pencil-square text-primary"></i> Editar Categoria
            </h4>

            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label fw-semibold">Nome da Categoria</label>
                    <input asp-for="Nome" class="form-control rounded-3" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CorHex" class="form-label fw-semibold">Cor de Identificação</label>
                    <input asp-for="CorHex" type="color" class="form-control form-control-color rounded-3 w-100" />
                    <span asp-validation-for="CorHex" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Icone" class="form-label fw-semibold">Classe do Ícone (Bootstrap Icons)</label>
                    <input asp-for="Icone" class="form-control rounded-3" />
                    <span asp-validation-for="Icone" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3">Cancelar</a>
                    <button type="submit" class="btn btn-primary rounded-3">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>
</div>
