@model ControleFinanceiro.Domain.Entities.Transacao
@using ControleFinanceiro.Domain.Enums

@{
    ViewData["Title"] = "Nova Transação";
}

<div class="max-w-2xl mx-auto">
    <div class="card-fintech p-6 sm:p-8">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl">
                <i class="bi bi-plus-circle-fill"></i>
            </div>
            <div>
                <h1 class="text-xl font-bold text-slate-900">Cadastrar Nova Transação</h1>
                <p class="text-xs text-slate-500">Registre uma despesa, receita ou compra parcelada no cartão.</p>
            </div>
        </div>

        <form asp-action="Create" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-rose-600 text-sm mb-4"></div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Tipo" class="block mb-2 text-sm font-medium text-slate-700">Tipo de Lançamento</label>
                    <select asp-for="Tipo" class="bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" id="selectTipo" asp-items="Html.GetEnumSelectList<TipoTransacao>()">
                    </select>
                    <span asp-validation-for="Tipo" class="text-rose-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="FormaPagamento" class="block mb-2 text-sm font-medium text-slate-700">Forma de Pagamento</label>
                    <select asp-for="FormaPagamento" class="bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" id="selectFormaPagamento" asp-items="Html.GetEnumSelectList<FormaPagamento>()">
                    </select>
                    <span asp-validation-for="FormaPagamento" class="text-rose-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <!-- Painel Condicional para Cartão de Crédito -->
            <div id="painelCartao" class="p-4 rounded-xl bg-blue-50/70 border border-blue-200 hidden">
                <h3 class="text-xs font-bold uppercase tracking-wider text-blue-800 mb-3 flex items-center gap-1.5">
                    <i class="bi bi-credit-card-2-front"></i> Detalhes do Cartão & Parcelamento
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="sm:col-span-2">
                        <label asp-for="CartaoCreditoId" class="block mb-1 text-xs font-semibold text-slate-700">Cartão</label>
                        <select asp-for="CartaoCreditoId" class="bg-white border border-blue-300 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" asp-items="ViewBag.CartaoCreditoId">
                            <option value="">-- Escolha o Cartão --</option>
                        </select>
                        <span asp-validation-for="CartaoCreditoId" class="text-rose-500 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="TotalParcelas" class="block mb-1 text-xs font-semibold text-slate-700">Nº de Parcelas</label>
                        <input asp-for="TotalParcelas" type="number" min="1" max="48" class="bg-white border border-blue-300 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" value="1" />
                        <span class="text-[11px] text-slate-500">1x à vista ou até 48x.</span>
                        <span asp-validation-for="TotalParcelas" class="text-rose-500 text-xs mt-1 block"></span>
                    </div>
                </div>
            </div>

            <div>
                <label asp-for="Descricao" class="block mb-2 text-sm font-medium text-slate-700">Descrição</label>
                <input asp-for="Descricao" class="bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Ex: Supermercado, Salário, Celular novo..." />
                <span asp-validation-for="Descricao" class="text-rose-500 text-xs mt-1 block"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label asp-for="Valor" class="block mb-2 text-sm font-medium text-slate-700">Valor Total (R$)</label>
                    <input asp-for="Valor" type="number" step="0.01" class="bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="0,00" />
                    <span asp-validation-for="Valor" class="text-rose-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="CategoriaId" class="block mb-2 text-sm font-medium text-slate-700">Categoria</label>
                    <select asp-for="CategoriaId" class="bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" asp-items="ViewBag.CategoriaId">
                        <option value="">-- Categoria --</option>
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-rose-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="ContaBancariaId" class="block mb-2 text-sm font-medium text-slate-700">Conta Bancária (à vista)</label>
                    <select asp-for="ContaBancariaId" class="bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" asp-items="ViewBag.ContaBancariaId">
                        <option value="">-- Padrão --</option>
                    </select>
                </div>

                <div>
                    <label asp-for="Data" class="block mb-2 text-sm font-medium text-slate-700">Data da Operação</label>
                    <input asp-for="Data" type="date" class="bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" />
                    <span asp-validation-for="Data" class="text-rose-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <div>
                <label asp-for="Observacao" class="block mb-2 text-sm font-medium text-slate-700">Observações (opcional)</label>
                <textarea asp-for="Observacao" class="bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" rows="3" placeholder="Detalhes adicionais..."></textarea>
                <span asp-validation-for="Observacao" class="text-rose-500 text-xs mt-1 block"></span>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a asp-action="Index" class="py-2.5 px-5 text-sm font-medium text-slate-600 bg-white rounded-xl border border-slate-300 hover:bg-slate-50 transition-colors">
                    Cancelar
                </a>
                <button type="submit" class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 font-semibold rounded-xl text-sm px-6 py-2.5 shadow-lg shadow-blue-600/20 transition-all hover:-translate-y-0.5">
                    Salvar Transação
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const selectForma = document.getElementById('selectFormaPagamento');
        const selectTipo = document.getElementById('selectTipo');
        const painelCartao = document.getElementById('painelCartao');

        function atualizarPainel() {
            if (selectForma.value === "2") {
                painelCartao.classList.remove('hidden');
                selectTipo.value = "2"; // Cartão é Despesa
                selectTipo.disabled = true;
            } else {
                painelCartao.classList.add('hidden');
                selectTipo.disabled = false;
            }
        }

        selectForma.addEventListener('change', atualizarPainel);
        atualizarPainel();
    </script>
}
