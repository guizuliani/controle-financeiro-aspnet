<!DOCTYPE html>
<html lang="pt-br" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FinanceControl</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Tailwind CSS Compilado (Produção) -->
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />

    <!-- Flowbite CSS -->
    <link href="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.css" rel="stylesheet" />

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }
        .card-fintech {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04), 0 2px 4px -2px rgba(0, 0, 0, 0.04);
            transition: all 0.2s ease-in-out;
        }
        .card-fintech:hover {
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.04);
            transform: translateY(-2px);
        }
    </style>
</head>
<body class="flex flex-col min-h-screen bg-slate-50 text-slate-800 antialiased">
    <!-- Navbar com Flowbite -->
    <nav class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50 shadow-md">
        <div class="max-w-7xl flex flex-wrap items-center justify-between mx-auto p-4">
            <a asp-controller="Home" asp-action="Index" class="flex items-center space-x-3 rtl:space-x-reverse">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center text-white shadow-lg shadow-blue-500/30">
                    <i class="bi bi-wallet2 text-xl"></i>
                </div>
                <span class="self-center text-xl font-bold whitespace-nowrap text-white tracking-tight">Finance<span class="text-blue-500">Control</span></span>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="flex items-center md:order-2 space-x-2 rtl:space-x-reverse">
                    <a asp-controller="Transacoes" asp-action="Create" class="text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 focus:ring-4 focus:ring-blue-300 font-semibold rounded-xl text-xs sm:text-sm px-3.5 py-2 text-center inline-flex items-center gap-1.5 shadow-lg shadow-blue-600/20 transition-all">
                        <i class="bi bi-plus-circle-fill"></i>
                        <span class="hidden sm:inline">Nova Transação</span>
                    </a>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        <button type="submit" title="Sair (@User.Identity.Name)" class="text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 rounded-xl text-xs px-3 py-2 inline-flex items-center gap-1.5 transition-colors">
                            <i class="bi bi-box-arrow-right"></i>
                            <span class="hidden lg:inline">@User.Identity.Name</span>
                        </button>
                    </form>

                    <button data-collapse-toggle="navbar-sticky" type="button" class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-slate-400 rounded-lg md:hidden hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-600" aria-controls="navbar-sticky" aria-expanded="false">
                        <span class="sr-only">Abrir menu</span>
                        <i class="bi bi-list text-2xl"></i>
                    </button>
                </div>

                <div class="items-center justify-between hidden w-full md:flex md:w-auto md:order-1" id="navbar-sticky">
                    <ul class="flex flex-col p-4 md:p-0 mt-4 text-sm font-medium border border-slate-800 rounded-xl bg-slate-900 md:space-x-1 rtl:space-x-reverse md:flex-row md:mt-0 md:border-0">
                        <li>
                            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-1.5 py-2 px-2.5 text-slate-300 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Transacoes" asp-action="Index" class="flex items-center gap-1.5 py-2 px-2.5 text-slate-300 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                                <i class="bi bi-arrow-down-up"></i> Transações
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Contas" asp-action="Index" class="flex items-center gap-1.5 py-2 px-2.5 text-slate-300 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                                <i class="bi bi-bank"></i> Contas
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Cartoes" asp-action="Index" class="flex items-center gap-1.5 py-2 px-2.5 text-slate-300 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                                <i class="bi bi-credit-card-2-front"></i> Cartões
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Orcamentos" asp-action="Index" class="flex items-center gap-1.5 py-2 px-2.5 text-slate-300 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                                <i class="bi bi-bullseye"></i> Metas
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Recorrencias" asp-action="Index" class="flex items-center gap-1.5 py-2 px-2.5 text-slate-300 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                                <i class="bi bi-arrow-repeat"></i> Fixas
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Pontos" asp-action="Index" class="flex items-center gap-1.5 py-2 px-2.5 text-amber-400 rounded-lg hover:bg-slate-800 hover:text-amber-300 transition-colors">
                                <i class="bi bi-stars"></i> Pontos
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Categorias" asp-action="Index" class="flex items-center gap-1.5 py-2 px-2.5 text-slate-300 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                                <i class="bi bi-tags"></i> Categorias
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Importacao" asp-action="Index" class="flex items-center gap-1.5 py-2 px-2.5 text-slate-300 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">
                                <i class="bi bi-file-earmark-arrow-up"></i> CSV/OFX
                            </a>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </nav>

    <!-- Conteúdo Principal -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">
        @if (TempData["Sucesso"] != null)
        {
            <div id="alert-sucesso" class="flex items-center p-4 mb-6 text-emerald-800 rounded-2xl bg-emerald-50 border border-emerald-200 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill text-emerald-600 text-xl me-3"></i>
                <div class="text-sm font-semibold flex-grow">@TempData["Sucesso"]</div>
                <button type="button" class="ms-auto -mx-1.5 -my-1.5 bg-emerald-50 text-emerald-500 rounded-lg focus:ring-2 focus:ring-emerald-400 p-1.5 hover:bg-emerald-100 inline-flex items-center justify-center h-8 w-8" data-dismiss-target="#alert-sucesso" aria-label="Close">
                    <span class="sr-only">Fechar</span>
                    <i class="bi bi-x text-lg"></i>
                </button>
            </div>
        }

        @if (TempData["Erro"] != null)
        {
            <div id="alert-erro" class="flex items-center p-4 mb-6 text-rose-800 rounded-2xl bg-rose-50 border border-rose-200 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-rose-600 text-xl me-3"></i>
                <div class="text-sm font-semibold flex-grow">@TempData["Erro"]</div>
                <button type="button" class="ms-auto -mx-1.5 -my-1.5 bg-rose-50 text-rose-500 rounded-lg focus:ring-2 focus:ring-rose-400 p-1.5 hover:bg-rose-100 inline-flex items-center justify-center h-8 w-8" data-dismiss-target="#alert-erro" aria-label="Close">
                    <span class="sr-only">Fechar</span>
                    <i class="bi bi-x text-lg"></i>
                </button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-6 mt-auto">
        <div class="max-w-7xl mx-auto px-4 text-center text-sm text-slate-500">
            &copy; @DateTime.Now.Year <span class="font-bold text-slate-700">FinanceControl</span> (.NET 10 MVC) | Arquitetura Hexagonal &bull; Tailwind CSS & Flowbite
        </div>
    </footer>

    <!-- Flowbite JS -->
    <script src="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
