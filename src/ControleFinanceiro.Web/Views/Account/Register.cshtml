@model ControleFinanceiro.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Criar Conta";
}

<div class="min-h-[75vh] flex items-center justify-center">
    <div class="w-full max-w-md card-fintech p-8">
        <div class="text-center mb-6">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center text-white mx-auto mb-3 shadow-lg shadow-blue-500/30">
                <i class="bi bi-person-plus-fill text-2xl"></i>
            </div>
            <h1 class="text-2xl font-extrabold text-slate-900">Criar Conta</h1>
            <p class="text-sm text-slate-500 mt-1">Comece a gerenciar suas finanças com segurança</p>
        </div>

        <form asp-action="Register" method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600 bg-rose-50 border border-rose-200 rounded-xl p-3"></div>

            <div>
                <label asp-for="Nome" class="block mb-1.5 text-sm font-semibold text-slate-700">Nome</label>
                <input asp-for="Nome" class="bg-slate-50 border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Seu nome" />
                <span asp-validation-for="Nome" class="text-xs text-rose-600"></span>
            </div>

            <div>
                <label asp-for="Email" class="block mb-1.5 text-sm font-semibold text-slate-700">E-mail</label>
                <input asp-for="Email" type="email" class="bg-slate-50 border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="seu@email.com" />
                <span asp-validation-for="Email" class="text-xs text-rose-600"></span>
            </div>

            <div>
                <label asp-for="Senha" class="block mb-1.5 text-sm font-semibold text-slate-700">Senha</label>
                <input asp-for="Senha" type="password" class="bg-slate-50 border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Mínimo 6 caracteres" />
                <span asp-validation-for="Senha" class="text-xs text-rose-600"></span>
            </div>

            <div>
                <label asp-for="ConfirmarSenha" class="block mb-1.5 text-sm font-semibold text-slate-700">Confirmar Senha</label>
                <input asp-for="ConfirmarSenha" type="password" class="bg-slate-50 border border-slate-200 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Repita a senha" />
                <span asp-validation-for="ConfirmarSenha" class="text-xs text-rose-600"></span>
            </div>

            <button type="submit" class="w-full text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 font-semibold rounded-xl text-sm px-5 py-3 text-center shadow-lg shadow-blue-600/20 transition-all">
                Criar Minha Conta
            </button>

            <p class="text-center text-sm text-slate-500">
                Já tem conta? <a asp-action="Login" class="font-semibold text-blue-600 hover:underline">Entrar</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
