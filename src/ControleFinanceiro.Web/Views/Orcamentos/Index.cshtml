@model IEnumerable<ControleFinanceiro.Application.DTOs.OrcamentoResumoDto>
@using System.Globalization
@{
    ViewData["Title"] = "Orçamentos e Metas";
    var culturaBr = new CultureInfo("pt-BR");
    int mes = ViewBag.Mes;
    int ano = ViewBag.Ano;
    var meses = new[] { "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro" };
}

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Orçamentos & Metas</h1>
        <p class="text-sm text-slate-500 mt-0.5">Defina tetos de gastos por categoria para @meses[mes - 1] de @ano</p>
    </div>

    <form method="get" class="flex items-center gap-2 bg-white p-2 rounded-2xl border border-slate-200 shadow-sm">
        <select name="mes" class="bg-slate-50 border border-slate-200 text-xs font-semibold rounded-xl p-2">
            @for (int i = 1; i <= 12; i++)
            {
                <option value="@i" selected="@(mes == i)">@meses[i - 1]</option>
            }
        </select>
        <select name="ano" class="bg-slate-50 border border-slate-200 text-xs font-semibold rounded-xl p-2">
            @for (int a = DateTime.Today.Year - 1; a <= DateTime.Today.Year + 2; a++)
            {
                <option value="@a" selected="@(ano == a)">@a</option>
            }
        </select>
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-xl px-3 py-2">Filtrar</button>
    </form>
</div>

<!-- Formulário Rápido de Meta -->
<div class="card-fintech p-5 mb-6">
    <h2 class="text-sm font-bold text-slate-800 mb-3">Definir / Atualizar Meta Mensal</h2>
    <form asp-action="Salvar" method="post" class="grid grid-cols-1 sm:grid-cols-3 gap-3 items-end">
        <input type="hidden" name="mes" value="@mes" />
        <input type="hidden" name="ano" value="@ano" />
        <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Categoria</label>
            <select name="categoriaId" asp-items="ViewBag.Categorias" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm"></select>
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Limite Mensal (R$)</label>
            <input type="number" name="valorLimite" step="0.01" min="0.01" required placeholder="Ex: 1200.00" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm" />
        </div>
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl px-4 py-2.5">
            <i class="bi bi-check-circle-fill"></i> Salvar Meta
        </button>
    </form>
</div>

@if (!Model.Any())
{
    <div class="card-fintech p-8 text-center text-slate-500">
        Nenhuma meta cadastrada para @meses[mes - 1] de @ano. Utilize o formulário acima para definir seus limites.
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        @foreach (var item in Model)
        {
            var barraCor = item.NivelAlerta == "Excedido" ? "bg-rose-600" : (item.NivelAlerta == "Atencao" ? "bg-amber-500" : "bg-emerald-500");
            var badgeCor = item.NivelAlerta == "Excedido" ? "bg-rose-100 text-rose-700" : (item.NivelAlerta == "Atencao" ? "bg-amber-100 text-amber-700" : "bg-emerald-100 text-emerald-700");
            var pctVisual = Math.Min(100m, item.PercentualUso);

            <div class="card-fintech p-5">
                <div class="flex items-center justify-between mb-2">
                    <span class="font-bold text-slate-900 inline-flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full" style="background-color:@item.CategoriaCorHex"></span>
                        @item.CategoriaNome
                    </span>
                    <span class="text-xs font-bold px-2.5 py-1 rounded-full @badgeCor">
                        @(item.NivelAlerta == "Excedido" ? "Excedido" : item.NivelAlerta == "Atencao" ? "Atenção (80%+)" : "Dentro da meta")
                    </span>
                </div>

                <div class="flex items-baseline justify-between text-sm mb-2">
                    <span class="text-slate-600">Gasto: <strong>@item.ValorGasto.ToString("C", culturaBr)</strong></span>
                    <span class="text-slate-500">Meta: @item.ValorLimite.ToString("C", culturaBr) (@item.PercentualUso.ToString("N1")%)</span>
                </div>

                <div class="w-full bg-slate-100 rounded-full h-2.5 mb-3 overflow-hidden">
                    <div class="@barraCor h-2.5 rounded-full transition-all" style="width: @pctVisual.ToString("0.#", CultureInfo.InvariantCulture)%"></div>
                </div>

                <div class="flex justify-end">
                    <form asp-action="Excluir" method="post" onsubmit="return confirm('Remover esta meta?');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="mes" value="@mes" />
                        <input type="hidden" name="ano" value="@ano" />
                        <button type="submit" class="text-xs text-rose-600 hover:underline font-medium">Remover</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
