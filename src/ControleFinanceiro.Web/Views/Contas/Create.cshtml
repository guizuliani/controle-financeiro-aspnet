@model ControleFinanceiro.Domain.Entities.ContaBancaria
@{
    ViewData["Title"] = "Nova Conta Bancária";
}

<div class="max-w-xl mx-auto card-fintech p-6">
    <h1 class="text-xl font-extrabold text-slate-900 mb-5">Nova Conta Bancária</h1>

    <form asp-action="Create" method="post" class="space-y-4">
        <div>
            <label asp-for="Nome" class="block text-sm font-semibold text-slate-700 mb-1"></label>
            <input asp-for="Nome" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm" placeholder="Ex: Nubank Conta, Itaú, XP Investimentos" />
            <span asp-validation-for="Nome" class="text-xs text-rose-600"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="Instituicao" class="block text-sm font-semibold text-slate-700 mb-1"></label>
                <input asp-for="Instituicao" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm" placeholder="Ex: Nubank, Itaú" />
            </div>
            <div>
                <label asp-for="Tipo" class="block text-sm font-semibold text-slate-700 mb-1"></label>
                <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoConta>()" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm"></select>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="SaldoInicial" class="block text-sm font-semibold text-slate-700 mb-1"></label>
                <input asp-for="SaldoInicial" type="number" step="0.01" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm" />
            </div>
            <div>
                <label asp-for="CorHex" class="block text-sm font-semibold text-slate-700 mb-1">Cor</label>
                <input asp-for="CorHex" type="color" class="h-10 w-full rounded-xl border border-slate-200 p-1 bg-slate-50" />
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4">
            <a asp-action="Index" class="px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancelar</a>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold">Salvar Conta</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
