@model IEnumerable<ControleFinanceiro.Application.DTOs.ContaBancariaResumoDto>
@using System.Globalization
@{
    ViewData["Title"] = "Contas Bancárias";
    var culturaBr = new CultureInfo("pt-BR");
}

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Contas & Carteiras</h1>
        <p class="text-sm text-slate-500 mt-0.5">Gerencie múltiplas contas correntes, poupanças e corretoras</p>
    </div>
    <a asp-action="Create" class="text-white bg-blue-600 hover:bg-blue-700 font-semibold rounded-xl text-sm px-4 py-2.5 inline-flex items-center gap-2 shadow-sm">
        <i class="bi bi-plus-lg"></i> Nova Conta
    </a>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    @foreach (var conta in Model)
    {
        <div class="card-fintech p-6 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-3">
                    <span class="inline-flex items-center gap-2 font-bold text-slate-900">
                        <span class="w-3 h-3 rounded-full" style="background-color:@conta.CorHex"></span>
                        @conta.Nome
                    </span>
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700">@conta.Tipo</span>
                </div>
                <p class="text-xs text-slate-500 mb-4">@(string.IsNullOrWhiteSpace(conta.Instituicao) ? "Instituição não informada" : conta.Instituicao)</p>

                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 mb-4">
                    <span class="text-xs text-slate-500 block">Saldo Atual</span>
                    <span class="text-2xl font-bold @(conta.SaldoAtual >= 0 ? "text-emerald-600" : "text-rose-600")">
                        @conta.SaldoAtual.ToString("C", culturaBr)
                    </span>
                    <span class="text-[11px] text-slate-400 block mt-0.5">Saldo inicial: @conta.SaldoInicial.ToString("C", culturaBr)</span>
                </div>
            </div>

            <div class="flex items-center justify-between pt-3 border-t border-slate-100 text-sm">
                <a asp-action="Edit" asp-route-id="@conta.Id" class="text-blue-600 hover:underline font-medium">
                    <i class="bi bi-pencil-square"></i> Editar
                </a>
                <form asp-action="Delete" asp-route-id="@conta.Id" method="post" onsubmit="return confirm('Deseja excluir esta conta?');">
                    <button type="submit" class="text-rose-600 hover:underline font-medium">
                        <i class="bi bi-trash"></i> Excluir
                    </button>
                </form>
            </div>
        </div>
    }
</div>
