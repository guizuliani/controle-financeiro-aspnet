@model IEnumerable<ControleFinanceiro.Models.ViewModels.CartaoResumoItem>
@using System.Globalization

@{
    ViewData["Title"] = "Cartões de Crédito";
    var culturaBr = new CultureInfo("pt-BR");
}

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
            <i class="bi bi-credit-card-2-front text-blue-600"></i> Meus Cartões de Crédito
        </h1>
        <p class="text-slate-500 text-sm mt-0.5">Gerencie seus limites, datas de fechamento e regras de pontuação.</p>
    </div>
    <div>
        <a asp-action="Create" class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 font-semibold rounded-xl text-sm px-4 py-2.5 inline-flex items-center gap-2 shadow-lg shadow-blue-600/20 transition-all hover:-translate-y-0.5">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Novo Cartão</span>
        </a>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    @if (Model.Any())
    {
        @foreach (var cartao in Model)
        {
            <div class="card-fintech overflow-hidden flex flex-col justify-between">
                <!-- Cartão Estilizado (Topo) -->
                <div class="p-6 text-white relative overflow-hidden" style="background: linear-gradient(135deg, @cartao.CorHex 0%, #0f172a 100%);">
                    <div class="flex justify-between items-start mb-6">
                        <div class="flex items-center gap-2">
                            <i class="bi bi-sim text-amber-400 text-3xl"></i>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-white/20 text-white backdrop-blur-sm border border-white/10">
                                @cartao.NomeProgramaPontos
                            </span>
                        </div>
                        <i class="bi bi-credit-card-fill text-2xl text-white/50"></i>
                    </div>

                    <h3 class="text-lg font-bold truncate text-white mb-4" title="@cartao.Nome">@cartao.Nome</h3>

                    <div class="grid grid-cols-3 gap-2 text-xs border-t border-white/10 pt-3">
                        <div>
                            <span class="text-white/60 block text-[10px] uppercase">Fechamento</span>
                            <strong class="text-white text-sm">Dia @cartao.DiaFechamento</strong>
                        </div>
                        <div>
                            <span class="text-white/60 block text-[10px] uppercase">Vencimento</span>
                            <strong class="text-white text-sm">Dia @cartao.DiaVencimento</strong>
                        </div>
                        <div class="text-right">
                            <span class="text-white/60 block text-[10px] uppercase">Fatura Atual</span>
                            <strong class="text-white text-sm">@cartao.FaturaMesAtual.ToString("C", culturaBr)</strong>
                        </div>
                    </div>
                </div>

                <!-- Limite e Ações (Base) -->
                <div class="p-5 flex flex-col justify-between flex-grow">
                    <div class="mb-4">
                        <div class="flex justify-between items-center text-xs text-slate-600 mb-1.5">
                            <span class="font-medium">Uso do Limite</span>
                            <span class="font-bold text-slate-800">@cartao.PercentualUso%</span>
                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-2 mb-2">
                            <div class="h-2 rounded-full @(cartao.PercentualUso > 80 ? "bg-rose-500" : (cartao.PercentualUso > 50 ? "bg-amber-500" : "bg-blue-600")) transition-all duration-300" 
                                 style="width: @cartao.PercentualUso%;"></div>
                        </div>
                        <div class="flex justify-between items-center text-xs text-slate-500">
                            <span>Utilizado: <strong class="text-rose-600">@cartao.LimiteUtilizado.ToString("C", culturaBr)</strong></span>
                            <span>Disponível: <strong class="text-emerald-600">@cartao.LimiteDisponivel.ToString("C", culturaBr)</strong></span>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 border-t border-slate-100 pt-3">
                        <a asp-action="Fatura" asp-route-id="@cartao.Id" class="flex-grow text-center text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 font-semibold rounded-xl text-xs py-2 px-3 transition-colors inline-flex items-center justify-center gap-1.5">
                            <i class="bi bi-receipt"></i> Ver Fatura
                        </a>
                        <a asp-action="Edit" asp-route-id="@cartao.Id" class="text-slate-600 hover:text-blue-600 bg-slate-100 hover:bg-slate-200 p-2 rounded-xl text-xs transition-colors" title="Editar">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@cartao.Id" class="text-slate-600 hover:text-rose-600 bg-slate-100 hover:bg-rose-50 p-2 rounded-xl text-xs transition-colors" title="Excluir">
                            <i class="bi bi-trash-fill"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-span-full">
            <div class="card-fintech p-12 text-center text-slate-400">
                <i class="bi bi-credit-card text-5xl mb-3 text-slate-300 block"></i>
                <h3 class="text-lg font-bold text-slate-700 mb-1">Nenhum cartão cadastrado ainda</h3>
                <p class="text-sm text-slate-500 mb-4">Cadastre seus cartões de crédito para controlar faturas e pontuações de milhas.</p>
                <a asp-action="Create" class="inline-flex items-center gap-2 text-white bg-blue-600 hover:bg-blue-700 font-semibold rounded-xl text-sm px-4 py-2.5">
                    <i class="bi bi-plus-circle-fill"></i> Cadastrar Primeiro Cartão
                </a>
            </div>
        </div>
    }
</div>
