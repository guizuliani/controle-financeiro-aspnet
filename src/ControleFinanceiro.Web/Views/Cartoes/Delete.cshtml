@model ControleFinanceiro.Domain.Entities.CartaoCredito
@using System.Globalization

@{
    ViewData["Title"] = "Excluir Cartão de Crédito";
    var culturaBr = new CultureInfo("pt-BR");
}

<div class="max-w-lg mx-auto">
    <div class="card-fintech p-6 sm:p-8 border-rose-200">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div>
                <h1 class="text-xl font-bold text-rose-600">Confirmar Exclusão</h1>
                <p class="text-xs text-slate-500">Esta ação não pode ser desfeita.</p>
            </div>
        </div>

        <p class="text-sm text-slate-700 mb-4">Você tem certeza que deseja excluir o cartão <strong>@Model.Nome</strong>?</p>

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2 mb-6 text-sm">
            <div class="flex justify-between">
                <span class="text-slate-500">Limite Total:</span>
                <strong class="text-slate-800">@Model.LimiteTotal.ToString("C", culturaBr)</strong>
            </div>
            <div class="flex justify-between">
                <span class="text-slate-500">Fechamento / Vencimento:</span>
                <span class="text-slate-800 font-medium">Dia @Model.DiaFechamento / Dia @Model.DiaVencimento</span>
            </div>
            <div class="flex justify-between">
                <span class="text-slate-500">Programa de Pontos:</span>
                <span class="text-slate-800 font-medium">@(Model.AcumulaPontos ? Model.NomeProgramaPontos : "Não acumula")</span>
            </div>
        </div>

        @if (Model.Transacoes.Any())
        {
            <div class="p-4 mb-4 text-sm text-amber-800 rounded-xl bg-amber-50 border border-amber-200">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                Atenção: Este cartão possui <strong>@Model.Transacoes.Count transação(ões)</strong> vinculadas. Você não poderá excluí-lo até remover essas transações.
            </div>
        }

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="flex items-center justify-end gap-3">
                <a asp-action="Index" class="py-2.5 px-5 text-sm font-medium text-slate-600 bg-white rounded-xl border border-slate-300 hover:bg-slate-50 transition-colors">
                    Cancelar
                </a>
                <button type="submit" class="text-white bg-rose-600 hover:bg-rose-700 focus:ring-4 focus:ring-rose-300 font-semibold rounded-xl text-sm px-6 py-2.5 transition-all @(Model.Transacoes.Any() ? "opacity-50 cursor-not-allowed" : "hover:-translate-y-0.5 shadow-lg shadow-rose-600/20")" disabled="@(Model.Transacoes.Any())">
                    Excluir Definitivamente
                </button>
            </div>
        </form>
    </div>
</div>
