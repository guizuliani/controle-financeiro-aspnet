                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="md:col-span-2">
                        <label asp-for="Nome" class="block mb-2 text-sm font-medium text-slate-700">Nome do CartÃ£o</label>
                        <input asp-for="Nome" class="bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Ex: C6 Carbon Black, Nubank, ItaÃº..." />
                        <span asp-validation-for="Nome" class="text-rose-500 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Bandeira" class="block mb-2 text-sm font-medium text-slate-700">Bandeira</label>
                        <select asp-for="Bandeira" class="bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5">
                            <option value="Mastercard">Mastercard</option>
                            <option value="Visa">Visa</option>
                            <option value="Elo">Elo</option>
                            <option value="American Express">American Express</option>
                            <option value="Outra">Outra</option>
                        </select>
                        <span asp-validation-for="Bandeira" class="text-rose-500 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
                    <div>
                        <label asp-for="LimiteTotal" class="block mb-2 text-sm font-medium text-slate-700">Limite Total (R$)</label>
                        <input asp-for="LimiteTotal" type="number" step="0.01" class="bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="0,00" />
                        <span asp-validation-for="LimiteTotal" class="text-rose-500 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="DiaFechamento" class="block mb-2 text-sm font-medium text-slate-700">Dia de Fechamento</label>
                        <input asp-for="DiaFechamento" type="number" min="1" max="31" class="bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" />
                        <span class="text-[11px] text-slate-400">Dia do fechamento/corte.</span>
                        <span asp-validation-for="DiaFechamento" class="text-rose-500 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="DiaVencimento" class="block mb-2 text-sm font-medium text-slate-700">Dia de Vencimento</label>
                        <input asp-for="DiaVencimento" type="number" min="1" max="31" class="bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" />
                        <span class="text-[11px] text-slate-400">Dia do pagamento da fatura.</span>
                        <span asp-validation-for="DiaVencimento" class="text-rose-500 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <label asp-for="CorHex" class="block mb-2 text-sm font-medium text-slate-700">Cor do CartÃ£o</label>
                    <input asp-for="CorHex" type="color" class="p-1 h-10 w-full block bg-slate-50 border border-slate-300 rounded-xl cursor-pointer" value="#1e293b" />
                    <span asp-validation-for="CorHex" class="text-rose-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <!-- ConfiguraÃ§Ã£o de Pontos / Milhas -->
            <div class="p-5 rounded-2xl bg-amber-50/60 border border-amber-200/60">
                <label class="inline-flex items-center cursor-pointer mb-4">
                    <input asp-for="AcumulaPontos" type="checkbox" id="checkAcumulaPontos" class="sr-only peer">
                    <div class="relative w-11 h-6 bg-slate-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-amber-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500"></div>
                    <span class="ms-3 text-sm font-bold text-slate-800 flex items-center gap-1.5">
                        <i class="bi bi-stars text-amber-500"></i> Este cartÃ£o acumula pontos / milhas ou cashback?
                    </span>
                </label>

                <div id="secaoPontos" class="space-y-4 pt-2 border-t border-amber-200/50">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="NomeProgramaPontos" class="block mb-2 text-sm font-medium text-slate-700">Nome do Programa</label>
                            <input asp-for="NomeProgramaPontos" class="bg-white border border-amber-300 text-slate-900 text-sm rounded-xl focus:ring-amber-500 focus:border-amber-500 block w-full p-2.5" placeholder="Ex: Livelo, Esfera, Ãtomos, Smiles..." />
                            <span asp-validation-for="NomeProgramaPontos" class="text-rose-500 text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="TipoRegra" class="block mb-2 text-sm font-medium text-slate-700">Tipo de Regra</label>
                            <select asp-for="TipoRegra" class="bg-white border border-amber-300 text-slate-900 text-sm rounded-xl focus:ring-amber-500 focus:border-amber-500 block w-full p-2.5" asp-items="Html.GetEnumSelectList<TipoRegraPontos>()">
                            </select>
                            <span asp-validation-for="TipoRegra" class="text-rose-500 text-xs mt-1 block"></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="FatorPontuacao" class="block mb-2 text-sm font-medium text-slate-700">Pontos / Multiplicador</label>
                            <input asp-for="FatorPontuacao" type="number" step="0.1" class="bg-white border border-amber-300 text-slate-900 text-sm rounded-xl focus:ring-amber-500 focus:border-amber-500 block w-full p-2.5" placeholder="Ex: 2.5" />
                            <span class="text-[11px] text-slate-500">Ex: 2.5 para 2.5 pts/US$, ou 1.0 para 1 pt/R$.</span>
                            <span asp-validation-for="FatorPontuacao" class="text-rose-500 text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="CotacaoDolarReferencia" class="block mb-2 text-sm font-medium text-slate-700">CotaÃ§Ã£o DÃ³lar ReferÃªncia (R$)</label>
                            <input asp-for="CotacaoDolarReferencia" type="number" step="0.01" class="bg-white border border-amber-300 text-slate-900 text-sm rounded-xl focus:ring-amber-500 focus:border-amber-500 block w-full p-2.5" placeholder="Ex: 5.50" />
                            <span class="text-[11px] text-slate-500">Usado se a regra for por dÃ³lar gasto.</span>
                            <span asp-validation-for="CotacaoDolarReferencia" class="text-rose-500 text-xs mt-1 block"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a asp-action="Index" class="py-2.5 px-5 text-sm font-medium text-slate-600 bg-white rounded-xl border border-slate-300 hover:bg-slate-50 transition-colors">
                    Cancelar
                </a>
                <button type="submit" class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 font-semibold rounded-xl text-sm px-6 py-2.5 shadow-lg shadow-blue-600/20 transition-all hover:-translate-y-0.5">
                    Salvar CartÃ£o
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const checkPontos = document.getElementById('checkAcumulaPontos');
        const secaoPontos = document.getElementById('secaoPontos');

        function togglePontos() {
            if (checkPontos.checked) {
                secaoPontos.classList.remove('hidden');
            } else {
                secaoPontos.classList.add('hidden');
            }
        }

        checkPontos.addEventListener('change', togglePontos);
        togglePontos();
    </script>
}
