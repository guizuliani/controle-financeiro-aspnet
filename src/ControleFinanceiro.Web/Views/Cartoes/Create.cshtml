            </div>
        </div>

        <form asp-action="Create" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-rose-600 text-sm mb-4"></div>

            <!-- Dados Principais -->
            <div>
                <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-3 flex items-center gap-2">
                    <i class="bi bi-info-circle"></i> Dados do CartÃ£o
