@model ControleFinanceiro.Models.ViewModels.FaturaViewModel
@using System.Globalization

@{
    ViewData["Title"] = $"Fatura {Model.Cartao.Nome} - {Model.Mes:D2}/{Model.Ano}";
    var culturaBr = new CultureInfo("pt-BR");
    var meses = new[] { "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro" };
}

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div>
        <div class="flex items-center gap-2 mb-1">
            <a asp-action="Index" class="inline-flex items-center gap-1 text-xs font-semibold text-slate-500 hover:text-blue-600 bg-white border border-slate-200 px-3 py-1.5 rounded-full shadow-sm hover:bg-slate-50 transition-colors">
                <i class="bi bi-arrow-left"></i> Voltar aos Cartões
            </a>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Fatura de @meses[Model.Mes - 1] / @Model.Ano</h1>
        </div>
        <p class="text-slate-500 text-sm">Cartão: <strong class="text-slate-700">@Model.Cartao.Nome</strong> | Vencimento: <strong class="text-slate-700">@Model.DataVencimento.ToString("dd/MM/yyyy")</strong></p>
    </div>

    <!-- Filtro de Mês/Ano da Fatura -->
    <form method="get" class="flex flex-wrap items-center gap-2 bg-white p-2 rounded-2xl border border-slate-200 shadow-sm">
        <input type="hidden" name="id" value="@Model.Cartao.Id" />
        <select name="mes" class="bg-slate-50 border border-slate-200 text-slate-800 text-xs font-semibold rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-2">
            @for (int i = 1; i <= 12; i++)
            {
                <option value="@i" selected="@(Model.Mes == i)">@meses[i - 1]</option>
            }
        </select>

        <select name="ano" class="bg-slate-50 border border-slate-200 text-slate-800 text-xs font-semibold rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-2">
            @for (int a = DateTime.Today.Year - 1; a <= DateTime.Today.Year + 2; a++)
            {
                <option value="@a" selected="@(Model.Ano == a)">@a</option>
            }
        </select>

        <button type="submit" class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 font-medium rounded-xl text-xs px-3 py-2 transition-colors">
            <i class="bi bi-funnel-fill"></i> Filtrar
        </button>
    </form>
</div>

<!-- Resumo da Fatura (3 Cards) -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="card-fintech p-5 flex flex-col justify-between">
        <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Valor da Fatura</span>
            <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-lg">
                <i class="bi bi-receipt"></i>
            </div>
        </div>
        <h3 class="text-2xl font-bold text-rose-600">@Model.TotalFatura.ToString("C", culturaBr)</h3>
    </div>

    <div class="card-fintech p-5 flex flex-col justify-between">
        <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Pontos Nesta Fatura</span>
            <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center text-lg">
                <i class="bi bi-stars"></i>
            </div>
        </div>
        <div>
            <h3 class="text-2xl font-bold text-amber-500">@Model.TotalPontos.ToString("N0", culturaBr) <span class="text-xs font-normal text-slate-400">pts</span></h3>
            <span class="text-xs text-slate-400">@(Model.Cartao.AcumulaPontos ? Model.Cartao.NomeProgramaPontos : "Sem programa")</span>
        </div>
    </div>

    <div class="card-fintech p-5 flex flex-col justify-between">
        <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Status</span>
            @if (Model.FaturaPaga)
            {
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                    <i class="bi bi-check-circle-fill me-1"></i> Fatura Paga
                </span>
            }
            else
            {
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-rose-100 text-rose-800">
                    <i class="bi bi-clock-history me-1"></i> Em Aberto
                </span>
            }
        </div>

        @if (!Model.FaturaPaga && Model.Transacoes.Any())
        {
            <form asp-action="PagarFatura" method="post" onsubmit="return confirm('Confirma o pagamento desta fatura? Isso registrará uma despesa no extrato da sua conta bancária.');">
                <input type="hidden" name="id" value="@Model.Cartao.Id" />
                <input type="hidden" name="mes" value="@Model.Mes" />
                <input type="hidden" name="ano" value="@Model.Ano" />
                <button type="submit" class="w-full text-white bg-emerald-600 hover:bg-emerald-700 font-semibold rounded-xl text-sm py-2 px-4 shadow-lg shadow-emerald-600/20 transition-all hover:-translate-y-0.5 inline-flex items-center justify-center gap-1.5">
                    <i class="bi bi-cash-coin"></i> Pagar Fatura Agora
                </button>
            </form>
        }
        else if (Model.FaturaPaga)
        {
            <button class="w-full text-slate-400 bg-slate-100 font-medium rounded-xl text-sm py-2 px-4 cursor-not-allowed" disabled>
                <i class="bi bi-check-all me-1"></i> Fatura Liquidada
            </button>
        }
        else
        {
            <span class="text-xs text-slate-400">Nenhuma despesa para pagamento.</span>
        }
    </div>
</div>

<!-- Lançamentos na Fatura -->
<div class="card-fintech p-6">
    <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
        <i class="bi bi-list-check text-blue-600"></i> Lançamentos desta Fatura (@Model.Transacoes.Count)
    </h2>

    @if (Model.Transacoes.Any())
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left text-slate-600">
                <thead class="text-xs text-slate-500 uppercase bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th scope="col" class="px-4 py-3">Data</th>
                        <th scope="col" class="px-4 py-3">Descrição</th>
                        <th scope="col" class="px-4 py-3">Parcela</th>
                        <th scope="col" class="px-4 py-3">Categoria</th>
                        <th scope="col" class="px-4 py-3 text-right">Pontos</th>
                        <th scope="col" class="px-4 py-3 text-right">Valor</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var t in Model.Transacoes)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-3 text-xs text-slate-500">@t.Data.ToString("dd/MM/yyyy")</td>
                            <td class="px-4 py-3 font-semibold text-slate-800">
                                <div>@t.Descricao</div>
                                @if (!string.IsNullOrEmpty(t.Observacao))
                                {
                                    <small class="text-slate-400 font-normal">@t.Observacao</small>
                                }
                            </td>
                            <td class="px-4 py-3">
                                @if (t.TotalParcelas > 1)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                                        @t.NumeroParcela / @t.TotalParcelas
                                    </span>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400">À vista</span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium text-white" style="background-color: @(t.Categoria?.CorHex ?? "#6c757d");">
                                    <i class="bi @(t.Categoria?.Icone ?? "bi-tag") me-1"></i> @(t.Categoria?.Nome ?? "Sem categoria")
                                </span>
                            </td>
                            <td class="px-4 py-3 text-right">
                                @if (t.PontosGerados > 0)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-amber-100 text-amber-800">
                                        +@t.PontosGerados.ToString("N1", culturaBr) pts
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-400 text-xs">-</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-right font-bold text-rose-600">
                                @t.Valor.ToString("C", culturaBr)
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="border-t-2 border-slate-200 bg-slate-50 text-xs uppercase font-bold text-slate-700">
                    <tr>
                        <td colspan="4" class="px-4 py-3">TOTAL</td>
                        <td class="px-4 py-3 text-right text-amber-600">+@Model.TotalPontos.ToString("N1", culturaBr) pts</td>
                        <td class="px-4 py-3 text-right text-rose-600 text-sm">@Model.TotalFatura.ToString("C", culturaBr)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-12 text-slate-400">
            <i class="bi bi-inbox text-4xl mb-2 block"></i>
            <h3 class="font-bold text-slate-700">Fatura vazia</h3>
            <p class="text-sm">Não há lançamentos de cartão registrados para o período de @meses[Model.Mes - 1]/@Model.Ano.</p>
        </div>
    }
</div>
