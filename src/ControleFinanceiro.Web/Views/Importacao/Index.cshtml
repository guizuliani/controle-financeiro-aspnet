@using ControleFinanceiro.Domain.Enums
@{
    ViewData["Title"] = "Importar & Exportar Extratos";
}

<div class="mb-6">
    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Importação & Exportação</h1>
    <p class="text-sm text-slate-500 mt-0.5">Importe extratos bancários (CSV ou OFX) ou exporte suas transações em CSV</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="card-fintech p-6">
        <h2 class="text-lg font-bold text-slate-900 mb-2"><i class="bi bi-cloud-upload-fill text-blue-600"></i> Importar Extrato (CSV / OFX)</h2>
        <p class="text-xs text-slate-500 mb-4">Para CSV, utilize o formato: <code>Data;Descricao;Valor</code> (ex: <code>2026-11-15;Supermercado;-150.00</code>).</p>

        <form asp-action="Importar" method="post" enctype="multipart/form-data" class="space-y-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Arquivo (.csv ou .ofx)</label>
                <input type="file" name="arquivo" accept=".csv,.ofx" required class="block w-full text-sm text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Categoria Padrão</label>
                    <select name="categoriaId" asp-items="ViewBag.Categorias" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm"></select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Destino</label>
                    <select name="formaPagamento" asp-items="Html.GetEnumSelectList<FormaPagamento>()" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm"></select>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Conta Bancária</label>
                    <select name="contaBancariaId" asp-items="ViewBag.Contas" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm">
                        <option value="">-- Selecione --</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Cartão de Crédito</label>
                    <select name="cartaoCreditoId" asp-items="ViewBag.Cartoes" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm">
                        <option value="">-- Selecione --</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl px-5 py-2.5 text-sm">
                Importar Lançamentos
            </button>
        </form>
    </div>

    <div class="card-fintech p-6 flex flex-col justify-between">
        <div>
            <h2 class="text-lg font-bold text-slate-900 mb-2"><i class="bi bi-file-earmark-spreadsheet-fill text-emerald-600"></i> Exportar Extrato em CSV</h2>
            <p class="text-sm text-slate-500 mb-4">Baixe todas as suas transações em formato CSV compatível com Microsoft Excel e Google Planilhas.</p>
        </div>
        <a asp-action="ExportarCsv" class="w-full text-center bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl px-5 py-2.5 text-sm">
            <i class="bi bi-download"></i> Baixar Extrato Completo (CSV)
        </a>
    </div>
</div>
