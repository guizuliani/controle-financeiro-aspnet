@model IEnumerable<ControleFinanceiro.Domain.Entities.LancamentoRecorrente>
@using System.Globalization
@using ControleFinanceiro.Domain.Enums
@{
    ViewData["Title"] = "Lançamentos Recorrentes";
    var culturaBr = new CultureInfo("pt-BR");
    int mesAtual = ViewBag.MesAtual;
    int anoAtual = ViewBag.AnoAtual;
}

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Lançamentos Recorrentes</h1>
        <p class="text-sm text-slate-500 mt-0.5">Gerencie assinaturas, aluguel, salário e despesas fixas mensais</p>
    </div>

    <div class="flex items-center gap-2">
        <form asp-action="GerarMes" method="post">
            <input type="hidden" name="mes" value="@mesAtual" />
            <input type="hidden" name="ano" value="@anoAtual" />
            <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-xl px-4 py-2.5 inline-flex items-center gap-2 shadow-sm">
                <i class="bi bi-lightning-charge-fill"></i> Gerar Mês Atual (@mesAtual.ToString("D2")/@anoAtual)
            </button>
        </form>
        <a asp-action="Create" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl px-4 py-2.5 inline-flex items-center gap-2 shadow-sm">
            <i class="bi bi-plus-lg"></i> Nova Recorrência
        </a>
    </div>
</div>

<div class="card-fintech overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm text-left text-slate-600">
            <thead class="text-xs text-slate-500 uppercase bg-slate-50 border-b border-slate-100">
                <tr>
                    <th class="px-6 py-3">Descrição</th>
                    <th class="px-6 py-3">Categoria</th>
                    <th class="px-6 py-3">Dia</th>
                    <th class="px-6 py-3">Valor</th>
                    <th class="px-6 py-3">Status</th>
                    <th class="px-6 py-3">Última Geração</th>
                    <th class="px-6 py-3 text-right">Ações</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-slate-50/80">
                        <td class="px-6 py-4 font-semibold text-slate-900">@item.Descricao</td>
                        <td class="px-6 py-4">@item.Categoria?.Nome</td>
                        <td class="px-6 py-4">Todo dia @item.DiaDoMes</td>
                        <td class="px-6 py-4 font-bold @(item.Tipo == TipoTransacao.Receita ? "text-emerald-600" : "text-rose-600")">
                            @(item.Tipo == TipoTransacao.Receita ? "+" : "-") @item.Valor.ToString("C", culturaBr)
                        </td>
                        <td class="px-6 py-4">
                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold @(item.Ativo ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-600")">
                                @(item.Ativo ? "Ativo" : "Pausado")
                            </span>
                        </td>
                        <td class="px-6 py-4 text-xs">
                            @(item.UltimoMesGerado.HasValue ? $"{item.UltimoMesGerado:D2}/{item.UltimoAnoGerado}" : "Nunca")
                        </td>
                        <td class="px-6 py-4 text-right space-x-2">
                            <form asp-action="AlternarStatus" asp-route-id="@item.Id" method="post" class="inline">
                                <button type="submit" class="text-xs font-semibold text-blue-600 hover:underline">@(item.Ativo ? "Pausar" : "Ativar")</button>
                            </form>
                            <form asp-action="Excluir" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('Excluir esta recorrência?');">
                                <button type="submit" class="text-xs font-semibold text-rose-600 hover:underline">Excluir</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
