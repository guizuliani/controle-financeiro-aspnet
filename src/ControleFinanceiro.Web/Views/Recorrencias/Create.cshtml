@model ControleFinanceiro.Domain.Entities.LancamentoRecorrente
@{
    ViewData["Title"] = "Nova Recorrência";
}

<div class="max-w-xl mx-auto card-fintech p-6">
    <h1 class="text-xl font-extrabold text-slate-900 mb-5">Novo Lançamento Recorrente</h1>

    <form asp-action="Create" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>

        <div>
            <label asp-for="Descricao" class="block text-sm font-semibold text-slate-700 mb-1"></label>
            <input asp-for="Descricao" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm" placeholder="Ex: Aluguel, Netflix, Salário" />
            <span asp-validation-for="Descricao" class="text-xs text-rose-600"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                <label asp-for="Valor" class="block text-sm font-semibold text-slate-700 mb-1"></label>
                <input asp-for="Valor" type="number" step="0.01" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm" />
            </div>
            <div>
                <label asp-for="Tipo" class="block text-sm font-semibold text-slate-700 mb-1"></label>
                <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoTransacao>()" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm"></select>
            </div>
            <div>
                <label asp-for="DiaDoMes" class="block text-sm font-semibold text-slate-700 mb-1"></label>
                <input asp-for="DiaDoMes" type="number" min="1" max="31" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm" />
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="CategoriaId" class="block text-sm font-semibold text-slate-700 mb-1">Categoria</label>
                <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm"></select>
            </div>
            <div>
                <label asp-for="FormaPagamento" class="block text-sm font-semibold text-slate-700 mb-1"></label>
                <select asp-for="FormaPagamento" asp-items="Html.GetEnumSelectList<FormaPagamento>()" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm"></select>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="ContaBancariaId" class="block text-sm font-semibold text-slate-700 mb-1"></label>
                <select asp-for="ContaBancariaId" asp-items="ViewBag.Contas" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm">
                    <option value="">-- Nenhuma --</option>
                </select>
            </div>
            <div>
                <label asp-for="CartaoCreditoId" class="block text-sm font-semibold text-slate-700 mb-1"></label>
                <select asp-for="CartaoCreditoId" asp-items="ViewBag.Cartoes" class="bg-slate-50 border border-slate-200 rounded-xl w-full p-2.5 text-sm">
                    <option value="">-- Nenhum --</option>
                </select>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4">
            <a asp-action="Index" class="px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700">Cancelar</a>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold">Salvar Recorrência</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
